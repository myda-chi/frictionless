<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.mydachi.frictionless</id>
    <name>Frictionless</name>
    <vendor>myda-chi</vendor>

    <idea-version since-build="252" />
    <description><![CDATA[
        <p><b>Frictionless</b> answers one question about a change set: which of it is anything actually checking?</p>
        <p>It walks the call graph from every changed method, runs only the tests that genuinely reach that
        method, and sorts the result into proven, behaviour changed, and unverified. The unverified bucket is
        the point — that is where bugs in AI-written code live, and CI stays green because nothing tests it.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>Git4Idea</depends>
    <!-- E1: JUnitConfiguration lives in the Java and JUnit plugins, not the base platform. -->
    <depends>com.intellij.modules.java</depends>
    <depends>JUnit</depends>

    <resource-bundle>messages.MyBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Frictionless" anchor="right"
                    factoryClass="com.github.mydachi.frictionless.toolwindow.FrictionlessToolWindowFactory"/>
        <notificationGroup id="Frictionless" displayType="BALLOON"/>
    </extensions>

    <actions>
        <!-- No default keyboard shortcuts: IntelliJ's shortcut map is dense and personally customised. -->
        <group id="Frictionless.Toolbar">
            <action id="Frictionless.SourcePicker"
                    class="com.github.mydachi.frictionless.actions.SourcePickerAction"/>
            <action id="Frictionless.Run"
                    class="com.github.mydachi.frictionless.actions.RunAnalysisAction"/>
            <action id="Frictionless.Play"
                    class="com.github.mydachi.frictionless.actions.PlayTourAction"/>
            <action id="Frictionless.Share"
                    class="com.github.mydachi.frictionless.actions.ShareSessionAction"/>
        </group>
    </actions>
</idea-plugin>
